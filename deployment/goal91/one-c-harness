#!/bin/sh
set -eu

usage='usage: one-c-harness --request-base64 TOKEN'
if [ "$#" -ne 2 ] || [ "$1" != '--request-base64' ]; then
    printf '%s\n' "$usage" >&2
    exit 64
fi

token=$2
case "$token" in
    ''|*[!A-Za-z0-9+/=]*)
        printf '%s\n' 'invalid base64 request token' >&2
        exit 64
        ;;
esac

host=${TERMINAL_SSH_HOST:?TERMINAL_SSH_HOST is required}
user=${TERMINAL_SSH_USER:?TERMINAL_SSH_USER is required}
port=${TERMINAL_SSH_PORT:-22}
key=${TERMINAL_SSH_KEY:?TERMINAL_SSH_KEY is required}
known_hosts=${HOME:?HOME is required}/.ssh/known_hosts

case "$host" in ''|*[!A-Za-z0-9.:-]*) exit 64 ;; esac
case "$user" in ''|*[!A-Za-z0-9._-]*) exit 64 ;; esac
case "$user" in [A-Za-z0-9]*) ;; *) exit 64 ;; esac
case "$port" in ''|*[!0-9]*) exit 64 ;; esac

if [ ! -r "$key" ] || [ ! -r "$known_hosts" ]; then
    printf '%s\n' 'SSH identity or known_hosts is not readable' >&2
    exit 69
fi

remote_source=/workspace/1c-agent-harness/.local/issue80-companion/source
remote_runtime_config=/workspace/1c-agent-harness/.local/one-c-runtime.json
# Routing only: the companion remains the owner of the closed request contract.
operation=$(printf '%s' "$token" | base64 --decode | python3 -c 'import json, sys; print(json.load(sys.stdin).get("operation", ""))')
case "$operation" in
    open|narrow|verify)
        # Set by deployment for the admitted business task, never a tool argument.
        remote_cwd=${ONE_C_HARNESS_PROJECT_CWD:-}
        case "$remote_cwd" in
            /srv/goal91-jet) ;;
            *) printf '%s\n' 'business workspace binding must be /srv/goal91-jet' >&2; exit 69 ;;
        esac
        coding_ssh_config=${ONE_C_HARNESS_CODING_SSH_CONFIG:-}
        case "$coding_ssh_config" in
            /*) ;;
            *) printf '%s\n' 'absolute coding SSH config is required' >&2; exit 69 ;;
        esac
        if [ ! -f "$coding_ssh_config" ] || [ ! -r "$coding_ssh_config" ]; then
            printf '%s\n' 'coding SSH config is not a readable file' >&2
            exit 69
        fi
        # The forced-command reference reads its command from stdin, not argv.
        remote_source=/opt/one-c-harness/60fa41bc6dcb6a6a4de38b22d2830501b9abfeba
        remote_runtime_config=/etc/one-c-harness/goal91-runtime.json
        remote_command="cd $remote_cwd && ONE_C_HARNESS_RUNTIME_CONFIG=$remote_runtime_config exec python3 -I -B -c 'import os, sys, runpy; assert sys.version_info >= (3, 11), \"deployment requires Python 3.11+\"; sys.path.insert(0, \"$remote_source\"); os.environ.update(PYTHONPATH=\"$remote_source\", PYTHONSAFEPATH=\"1\", PYTHONNOUSERSITE=\"1\"); runpy.run_module(\"one_c_harness.companion\", run_name=\"__main__\")' --request-base64 $token"
        printf '%s\n' "$remote_command" | ssh \
            -F "$ONE_C_HARNESS_CODING_SSH_CONFIG" \
            -o BatchMode=yes \
            -o IdentitiesOnly=yes \
            -o StrictHostKeyChecking=yes \
            -o ForwardAgent=no \
            -o IdentityAgent=none \
            -o RequestTTY=no \
            -T goal91-reference
        exit $?
        ;;
    *)
        # Keep diagnostic environment/source selection and retained refs unchanged.
        remote_command="cd $remote_source && ONE_C_HARNESS_RUNTIME_CONFIG=$remote_runtime_config exec ../bin/one-c-harness --request-base64 $token"
        ;;
esac

exec ssh \
    -F /dev/null \
    -o BatchMode=yes \
    -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=yes \
    -o "UserKnownHostsFile=$known_hosts" \
    -o ConnectTimeout=10 \
    -p "$port" \
    -i "$key" \
    "$user@$host" \
    "$remote_command"
