# Frozen unified-diff evidence contains literal context marker + source tabs.
experiments/issue12-narrow-context-20260826/diffs/*.diff whitespace=-space-before-tab,-trailing-space
experiments/issue12-narrow-context-20260826/patches/*.patch whitespace=-space-before-tab,-trailing-space

# Exact Issue #43 BSL patches and CRLF receipts are byte evidence.
experiments/issue43-inventory-transfer-core-loop/*.patch binary
experiments/issue43-inventory-transfer-core-loop/*-receipt.txt binary

# Exact task patches can contain CRLF bytes required by native replay.
experiments/**/exact-*.patch binary

# Native #85 receipts are literal UTF-8/BOM/CRLF evidence, not normalized text.
experiments/issue85-owner-dashboard/evidence/**/run--evidence--* -text whitespace=cr-at-eol

# Release IDs bind Git bytes; keep the installed Linux source identical on Windows.
/one_c_harness/** text eol=lf
/hermes-plugin/** text eol=lf
/deployment/goal91/*.py text eol=lf
/deployment/goal91/*.json text eol=lf
/pyproject.toml text eol=lf
/scripts/update_release.py text eol=lf
