+// Issue #14 probe-only instrumentation. Not production logic.
+Procedure Issue14RuntimeProbe(ReceiptPath, StagePath, Nonce) Export
+
+	Issue14WriteStage(StagePath, Nonce, "server-entered");
+	Writer = New TextWriter(ReceiptPath, TextEncoding.UTF8);
+	Try
+		Issue14WriteLine(Writer, "nonce", Nonce);
+		Issue14WriteLine(Writer, "mode", "<RUN_MODE>");
+		Issue14WriteLine(Writer, "complete", "false");
+		Issue14RunCase(Writer, "negative_single", 1);
+		Issue14RunCase(Writer, "zero_single", 2);
+		Issue14RunCase(Writer, "mixed_same_product", 3);
+		Issue14RunCase(Writer, "insufficient_stock_positive", 4);
+		Issue14RunCase(Writer, "normal_positive", 5);
+		Issue14RunCase(Writer, "minimum_positive", 6);
+		Issue14RunCase(Writer, "all_positive_multi_duplicate", 7);
+		Issue14WriteLine(Writer, "complete", "true");
+		Issue14WriteStage(StagePath, Nonce, "complete");
+	Except
+		Issue14WriteLine(Writer, "probeException", ErrorDescription());
+		Issue14WriteLine(Writer, "complete", "exception");
+		Issue14WriteStage(StagePath, Nonce, "exception");
+	EndTry;
+	Writer.Close();
+
+EndProcedure
+
