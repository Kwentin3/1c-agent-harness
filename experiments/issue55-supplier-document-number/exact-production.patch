diff --git a/Documents/SupplierInvoice/Ext/ObjectModule.bsl b/Documents/SupplierInvoice/Ext/ObjectModule.bsl
index dbf8986..71dc924 100644
--- a/Documents/SupplierInvoice/Ext/ObjectModule.bsl
+++ b/Documents/SupplierInvoice/Ext/ObjectModule.bsl
@@ -10,6 +10,28 @@ EndProcedure
 
 Procedure Posting(Cancel, PostingMode)
 	
+	If Not ValueIsFilled(SupplierDocumentNumber) Then
+		Common.MessageToUser(NStr("en = 'Specify the supplier document number before posting.'; tr = 'Göndermeden önce tedarikçi belge numarasını belirtin.'"),,,, Cancel);
+		Return;
+	EndIf;
+	Query = New Query;
+	Query.Text = "SELECT TOP 1
+	|	SupplierInvoice.Ref
+	|FROM
+	|	Document.SupplierInvoice AS SupplierInvoice
+	|WHERE
+	|	SupplierInvoice.Posted
+	|	AND SupplierInvoice.Supplier = &Supplier
+	|	AND SupplierInvoice.SupplierDocumentNumber = &SupplierDocumentNumber
+	|	AND SupplierInvoice.Ref <> &Ref";
+	Query.SetParameter("Supplier", Supplier);
+	Query.SetParameter("SupplierDocumentNumber", SupplierDocumentNumber);
+	Query.SetParameter("Ref", Ref);
+	If Not Query.Execute().IsEmpty() Then
+		Common.MessageToUser(NStr("en = 'A posted supplier invoice with this supplier document number already exists.'; tr = 'Bu tedarikçi belge numarasına sahip gönderilmiş bir tedarikçi faturası zaten var.'"),,,, Cancel);
+		Return;
+	EndIf;
+
 	// Initialization of additional properties for document posting.
 	PostingManagement.InitializeAdditionalPropertiesForPosting(Ref, AdditionalProperties);
 	
