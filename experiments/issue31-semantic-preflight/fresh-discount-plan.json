    "phases": {
      "red": {"path": "fresh-red-receipt.txt", "expected": [["case", "fresh-red"], ["amount99Accepted", "Yes"], ["amount100Accepted", "No"], ["amount101Accepted", "No"], ["complete", "true"]], "bindings": [["amount99", "discountAccepted", "amount99Accepted"], ["amount100", "discountAccepted", "amount100Accepted"], ["amount101", "discountAccepted", "amount101Accepted"]], "controls": ["case", "complete"]},
