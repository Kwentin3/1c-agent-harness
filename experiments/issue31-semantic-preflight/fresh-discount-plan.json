    {"id": "always-discount", "rationale": "A promotion guard may be skipped.", "predictions": {"amount99": {"discountAccepted": "Yes"}, "amount100": {"discountAccepted": "Yes"}, "amount101": {"discountAccepted": "Yes"}}},
    {"id": "never-discount", "rationale": "The promotion may never be applied.", "predictions": {"amount99": {"discountAccepted": "No"}, "amount100": {"discountAccepted": "No"}, "amount101": {"discountAccepted": "No"}}},
    {"id": "at-most-100", "rationale": "The comparison direction may be reversed.", "predictions": {"amount99": {"discountAccepted": "Yes"}, "amount100": {"discountAccepted": "Yes"}, "amount101": {"discountAccepted": "No"}}}
  ],
  "receipts": {
