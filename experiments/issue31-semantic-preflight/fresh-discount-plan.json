    {"id": "threshold", "statement": "The discount applies at 100 and above.", "basis": "user-task", "taskQuote": "only when the order amount is at least 100"},
    {"id": "preservation", "statement": "An amount below 100 retains full price.", "basis": "user-task", "taskQuote": "retain full price below 100"}
  ],
  "observations": [
    {"id": "discountAccepted", "description": "The external scalar receipt says whether a discount was applied.", "clauses": ["threshold", "preservation"], "externallyCheckable": true, "scalar": true}
