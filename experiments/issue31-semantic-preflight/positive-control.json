{
  "schemaVersion": 1,
  "task": "Accept positive quantities and reject zero quantities.",
  "clauses": [
    {
      "id": "positive-only",
      "statement": "A quantity is accepted exactly when it is greater than zero.",
      "basis": "user-task",
      "taskQuote": "Accept positive quantities and reject zero quantities."
    }
  ],
  "observations": [
    {
      "id": "accepted",
      "description": "Boolean acceptance result emitted as Yes or No.",
      "clauses": ["positive-only"],
      "externallyCheckable": true,
      "scalar": true
    }
  ],
  "cases": [
    {"id": "zero", "clauses": ["positive-only"], "expected": {"accepted": "No"}},
    {"id": "positive", "clauses": ["positive-only"], "expected": {"accepted": "Yes"}}
  ],
  "countermodels": [
    {
      "id": "non-negative",
      "rationale": "Using >= instead of > is a plausible boundary error.",
      "predictions": {"zero": {"accepted": "Yes"}, "positive": {"accepted": "Yes"}}
    },
    {
      "id": "reject-all",
      "rationale": "A guard may reject every input.",
      "predictions": {"zero": {"accepted": "No"}, "positive": {"accepted": "No"}}
    }
  ],
  "receipts": {
    "policy": "exact",
    "delimiter": "###",
    "phases": {
      "red": {
        "path": "positive-red-receipt.txt",
        "expected": [["case", "synthetic-red"], ["zeroAccepted", "Yes"], ["positiveAccepted", "Yes"], ["complete", "true"]],
        "bindings": [["zero", "accepted", "zeroAccepted"], ["positive", "accepted", "positiveAccepted"]],
        "controls": ["case", "complete"]
      },
      "green": {
        "path": "positive-green-receipt.txt",
        "expected": [["case", "synthetic-green"], ["zeroAccepted", "No"], ["positiveAccepted", "Yes"], ["complete", "true"]],
        "bindings": [["zero", "accepted", "zeroAccepted"], ["positive", "accepted", "positiveAccepted"]],
        "controls": ["case", "complete"]
      }
    }
  }
}
