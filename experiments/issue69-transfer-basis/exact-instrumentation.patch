+Procedure ITBasisClient()
+    W = New TextWriter(LaunchParameter, TextEncoding.UTF8);
+    W.Write("run###affc4e32-13c8-45c9-af1a-514f7bf4113c" + Chars.LF + "nonce###eb076390-a9a1-45fc-bd21-2eac28edb04f" + Chars.LF + "entry###true" + Chars.LF);
+    W.Close();
+    Try
+        Token = PostingManagement.ITBasisProbe(LaunchParameter);
+        W = New TextWriter(LaunchParameter, TextEncoding.UTF8);
+        W.Write("run###affc4e32-13c8-45c9-af1a-514f7bf4113c" + Chars.LF + "nonce###eb076390-a9a1-45fc-bd21-2eac28edb04f" + Chars.LF + "token###" + Token + Chars.LF + "returned###true" + Chars.LF + "complete###true" + Chars.LF);
+        W.Close();
+    Except
+        W = New TextWriter(LaunchParameter, TextEncoding.UTF8);
+        W.Write("error###client-error" + Chars.LF + "complete###true" + Chars.LF); W.Close();
+    EndTry;
+EndProcedure
