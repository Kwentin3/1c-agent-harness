 	// StandardSubsystems
 #If MobileClient Then
@@ -92,4 +96,28 @@ Procedure CollaborationSystemUsersChoiceFormGetProcessing(ChoicePurpose,
 	
 EndProcedure
 
-#EndRegion
\ No newline at end of file
+#EndRegion
+Procedure Goal85Client()
+    W = New TextWriter(LaunchParameter, "UTF-8");
+    W.Write("run###70b45136-d602-4756-9a73-3db628ded023" + Chars.LF + "nonce###f82b54ba-6db4-4d6b-80a6-4e6bf16efb24" + Chars.LF + "entry###true" + Chars.LF);
+    W.Close();
+    Try
+        Token = PostingManagement.Goal85Run(LaunchParameter, "70b45136-d602-4756-9a73-3db628ded023", "f82b54ba-6db4-4d6b-80a6-4e6bf16efb24");
+        F = GetForm("Report.Dashboard.Form.ReportForm",,, True);
+        FormCreated = F <> Undefined And F.OwnerDashboard.TableHeight = 22
+            And F.OwnerDashboard.Area(5, 2).Text = Format(1010, "NFD=2;NZ=0");
+        W = New TextWriter(LaunchParameter, "UTF-8");
+        W.Write("run###70b45136-d602-4756-9a73-3db628ded023" + Chars.LF + "nonce###f82b54ba-6db4-4d6b-80a6-4e6bf16efb24" + Chars.LF
+            + "token###" + Token + Chars.LF + "returned###true" + Chars.LF);
+        If FormCreated Then W.Write("formCreated###true" + Chars.LF);
+        Else W.Write("formCreated###false" + Chars.LF); EndIf;
+        W.Write("complete###true" + Chars.LF);
+        W.Close();
+    Except
+        W = New TextWriter(LaunchParameter, "UTF-8");
+        W.Write("error###client-form-error" + Chars.LF + "complete###true" + Chars.LF);
+        W.Close();
+        E = New TextWriter(LaunchParameter + ".client-error.txt", "UTF-8");
+        E.Write(ErrorDescription()); E.Close();
+    EndTry;
+EndProcedure
