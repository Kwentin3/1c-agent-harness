// Source candidate: native build/runtime on 8.5.1.1150 is not yet verified.
// LaunchParameter is the operator-owned exchange directory, never a model path.
&НаКлиенте
Процедура ПриОткрытии(Отказ)
    Корень = ПараметрЗапуска;
    Попытка
        ЗаписатьКлиентскуюОтметку(Корень + "/client-entered");
        ВыполнитьНаСервере(Корень);
    Исключение
        // Missing response remains a failed exchange for the launching owner.
    КонецПопытки;
    Попытка
        ЗаписатьКлиентскуюОтметку(Корень + "/complete");
    Исключение
        // Even an unwritable marker must not leave the managed client running.
    КонецПопытки;
    ПрекратитьРаботуСистемы();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьКлиентскуюОтметку(Путь)
    Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
    Запись.Записать("true");
    Запись.Закрыть();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере(Корень)
    Попытка
        ЗаписатьСервернуюОтметку(Корень + "/server-entered");
        // Marks entry into the settings operation, not a successful mutation.
        ЗаписатьСервернуюОтметку(Корень + "/settings-started");
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(ПрочитатьТекст(Корень + "/request.json"));
        Запрос = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        Если ТипЗнч(Запрос) <> Тип("Структура") Тогда
            ВызватьИсключение "invalid_request";
        КонецЕсли;
        Если Не Запрос.Свойство("action", Действие) Тогда
            ВызватьИсключение "invalid_request";
        КонецЕсли;
        Если Действие = "get" Тогда
            Если Запрос.Количество() <> 1 Тогда
                ВызватьИсключение "invalid_request";
            КонецЕсли;
        ИначеЕсли Действие = "set" Тогда
            Если Запрос.Количество() <> 3 Или Не Запрос.Свойство("levels", Имена)
                Или Не Запрос.Свойство("expectedLevels", ОжидаемыеИмена) Тогда
                ВызватьИсключение "invalid_request";
            КонецЕсли;
            Уровни = ПроверитьУровни(Имена);
            ОжидаемыеУровни = ПроверитьУровни(ОжидаемыеИмена);
        Иначе
            ВызватьИсключение "invalid_request";
        КонецЕсли;
        // Getter must succeed before any attempted change.
        Текущие = GetEventLogUsing();
        Ответ = Новый Структура;
        Ответ.Вставить("status", "ok");
        Если Действие = "set" Тогда
            Если УровниРавны(Текущие, ОжидаемыеУровни) Тогда
                SetEventLogUsing(Уровни);
                Текущие = GetEventLogUsing();
            Иначе
                Ответ.Вставить("status", "conflict");
                Ответ.Вставить("reasonCode", "configuration_conflict");
            КонецЕсли;
        КонецЕсли;
        Ответ.Вставить("levels", ИменаУровней(Текущие));
    Исключение
        Ответ = Новый Структура;
        Ответ.Вставить("status", "blocked");
        Ответ.Вставить("reasonCode", "native_settings_failed");
    КонецПопытки;
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Ответ);
    Текст = Запись.Закрыть();
    ФайлОтвета = Новый ЗаписьТекста(Корень + "/response.json", КодировкаТекста.UTF8);
    ФайлОтвета.Записать(Текст);
    ФайлОтвета.Закрыть();
    ЗаписатьСервернуюОтметку(Корень + "/settings-returned");
КонецПроцедуры

&НаСервере
Функция УровниРавны(Текущие, Ожидаемые)
    Если Текущие.Количество() <> Ожидаемые.Количество() Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Каждого Уровень Из Текущие Цикл
        Если Ожидаемые.Найти(Уровень) = Неопределено Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

&НаСервере
Функция ПроверитьУровни(Имена)
    Если ТипЗнч(Имена) <> Тип("Массив") Тогда
        ВызватьИсключение "invalid_levels";
    КонецЕсли;
    Результат = Новый Массив;
    Проверенные = Новый Массив;
    Для Каждого Имя Из Имена Цикл
        Если ТипЗнч(Имя) <> Тип("Строка") Или Проверенные.Найти(Имя) <> Неопределено Тогда
            ВызватьИсключение "invalid_levels";
        КонецЕсли;
        Если Имя = "Error" Тогда
            Уровень = EventLogLevel.Error;
        ИначеЕсли Имя = "Warning" Тогда
            Уровень = EventLogLevel.Warning;
        ИначеЕсли Имя = "Information" Тогда
            Уровень = EventLogLevel.Information;
        ИначеЕсли Имя = "Note" Тогда
            Уровень = EventLogLevel.Note;
        Иначе
            ВызватьИсключение "invalid_levels";
        КонецЕсли;
        Проверенные.Добавить(Имя);
        Результат.Добавить(Уровень);
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервере
Функция ИменаУровней(Уровни)
    Результат = Новый Массив;
    Если Уровни.Найти(EventLogLevel.Error) <> Неопределено Тогда
        Результат.Добавить("Error");
    КонецЕсли;
    Если Уровни.Найти(EventLogLevel.Warning) <> Неопределено Тогда
        Результат.Добавить("Warning");
    КонецЕсли;
    Если Уровни.Найти(EventLogLevel.Information) <> Неопределено Тогда
        Результат.Добавить("Information");
    КонецЕсли;
    Если Уровни.Найти(EventLogLevel.Note) <> Неопределено Тогда
        Результат.Добавить("Note");
    КонецЕсли;
    Если Результат.Количество() <> Уровни.Количество() Тогда
        ВызватьИсключение "unsupported_native_levels";
    КонецЕсли;
    Возврат Результат;
КонецФункции

&НаСервере
Процедура ЗаписатьСервернуюОтметку(Путь)
    Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
    Запись.Записать("true");
    Запись.Закрыть();
КонецПроцедуры

&НаСервере
Функция ПрочитатьТекст(Путь)
    Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
    Текст = Чтение.Прочитать();
    Чтение.Закрыть();
    Возврат Текст;
КонецФункции
