&НаКлиенте
Процедура ПриОткрытии(Отказ)
    Корень = ПараметрЗапуска;
    ЗаписатьКлиентскуюОтметку(Корень + "/client-entered");
    ВыгрузитьНаСервере(Корень);
    ЗаписатьКлиентскуюОтметку(Корень + "/complete");
    ПрекратитьРаботуСистемы();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьКлиентскуюОтметку(Путь)
    Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
    Запись.Записать("true");
    Запись.Закрыть();
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьНаСервере(Корень)
    ЗаписатьСервернуюОтметку(Корень + "/server-entered");
    Отбор = Новый Структура;
    Отбор.Вставить("StartDate", Дата(ПрочитатьПараметр(Корень + "/start.txt")));
    Отбор.Вставить("EndDate", Дата(ПрочитатьПараметр(Корень + "/end.txt")));
    ИмяСобытия = ПрочитатьПараметр(Корень + "/filter-event.txt");
    Если ИмяСобытия <> "" Тогда
        Отбор.Вставить("Event", ИмяСобытия);
    КонецЕсли;
    ИмяПользователя = ПрочитатьПараметр(Корень + "/filter-user.txt");
    Если ИмяПользователя <> "" Тогда
        Отбор.Вставить("User", ИмяПользователя);
    КонецЕсли;
    ИмяМетаданных = ПрочитатьПараметр(Корень + "/filter-metadata.txt");
    Если ИмяМетаданных <> "" Тогда
        Отбор.Вставить("Metadata", ИмяМетаданных);
    КонецЕсли;
    Максимум = Число(ПрочитатьПараметр(Корень + "/maximum-count.txt"));
    ЗаписатьСервернуюОтметку(Корень + "/export-started");
    ВыгрузитьЖурналРегистрации(
        Корень + "/output.xml",
        Отбор,
        "Date,Level,Event,EventPresentation,User,UserPresentation,Metadata,MetadataPresentation,TransactionStatus",
        ,
        Максимум
    );
    ЗаписатьСервернуюОтметку(Корень + "/export-returned");
КонецПроцедуры

&НаСервере
Функция ПрочитатьПараметр(Путь)
    Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
    Значение = Чтение.Прочитать();
    Чтение.Закрыть();
    Возврат Значение;
КонецФункции

&НаСервере
Процедура ЗаписатьСервернуюОтметку(Путь)
    Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
    Запись.Записать("true");
    Запись.Закрыть();
КонецПроцедуры
