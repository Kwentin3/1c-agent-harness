{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kwentin3/1c-agent-harness/contracts/adjudication-ledger.schema.json",
  "title": "Per-item human adjudication ledger",
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correct", "rationale", "citedLocators"],
      "properties": {
        "correct": {"type": "boolean"},
        "rationale": {"type": "string", "minLength": 1},
        "citedLocators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "dangerousClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "claims", "rationale"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "claims": {"$ref": "#/$defs/strings"},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "experimentId", "reviewer", "questions", "dangerousClaims"],
  "properties": {
    "schemaVersion": {"const": 1},
    "experimentId": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "items"],
        "properties": {
          "questionId": {"type": "string", "minLength": 1},
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["index", "expected", "arms"],
              "properties": {
                "index": {"type": "integer", "minimum": 1},
                "expected": {"type": "string", "minLength": 1},
                "arms": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["baseline", "candidate"],
                  "properties": {
                    "baseline": {"$ref": "#/$defs/verdict"},
                    "candidate": {"$ref": "#/$defs/verdict"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "dangerousClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": {"$ref": "#/$defs/dangerousClaims"},
        "candidate": {"$ref": "#/$defs/dangerousClaims"}
      }
    }
  }
}
