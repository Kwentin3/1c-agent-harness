{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kwentin3/1c-agent-harness/contracts/adjudication.schema.json",
  "title": "Hash-bound human adjudication for two frozen arms",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factsCorrect", "factsTotal", "dangerousFalseClaims"],
      "properties": {
        "factsCorrect": {"type": "integer", "minimum": 0},
        "factsTotal": {"type": "integer", "minimum": 1},
        "dangerousFalseClaims": {"type": "integer", "minimum": 0}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "experimentId", "identity", "arms", "reviewer"],
  "properties": {
    "schemaVersion": {"const": 2},
    "experimentId": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotContentId", "questionSetSha256", "oracleSha256", "ledgerSha256", "baselineAnswerSha256", "candidateAnswerSha256"],
      "properties": {
        "snapshotContentId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "questionSetSha256": {"$ref": "#/$defs/sha256"},
        "oracleSha256": {"$ref": "#/$defs/sha256"},
        "ledgerSha256": {"$ref": "#/$defs/sha256"},
        "baselineAnswerSha256": {"$ref": "#/$defs/sha256"},
        "candidateAnswerSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": {"$ref": "#/$defs/arm"},
        "candidate": {"$ref": "#/$defs/arm"}
      }
    }
  }
}
