{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kwentin3/1c-agent-harness/contracts/answer.schema.json",
  "title": "1C evidence-backed answer",
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string"}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "startLine", "endLine", "claimIds"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "startLine": {"type": "integer", "minimum": 1},
        "endLine": {"type": "integer", "minimum": 1},
        "claimIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "experimentId", "snapshotContentId", "questionSetSha256", "client", "answers", "metrics"],
  "properties": {
    "schemaVersion": {"const": 1},
    "experimentId": {"type": "string", "minLength": 1},
    "snapshotContentId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "questionSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "answer", "facts", "inferences", "assumptions", "unknowns", "locators"],
        "properties": {
          "questionId": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "description": "Non-authoritative summary. Every material proposition must also appear in a classified claim; semantic enforcement remains human."},
          "facts": {"type": "array", "description": "Every fact id must be covered by at least one locator.", "items": {"$ref": "#/$defs/claim"}},
          "inferences": {"type": "array", "description": "Every inference id must be covered by at least one locator; human review checks source sufficiency.", "items": {"$ref": "#/$defs/claim"}},
          "assumptions": {"type": "array", "description": "May remain without a locator when explicitly classified as an assumption.", "items": {"$ref": "#/$defs/claim"}},
          "unknowns": {"type": "array", "description": "May remain without a locator when explicitly classified as unknown.", "items": {"$ref": "#/$defs/claim"}},
          "locators": {"type": "array", "items": {"$ref": "#/$defs/locator"}}
        }
      }
    },
    "metrics": {"type": "object", "additionalProperties": true}
  }
}
